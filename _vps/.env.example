# suryateja.pro — environment variables
# Copy to .env on the VPS. Never commit the real .env.

NODE_ENV=production
PORT=3000
DB_PATH=/data/contact.sqlite

# Gmail SMTP — create an App Password at:
#   https://myaccount.google.com/apppasswords
GMAIL_USER=emailsuryateja.m@gmail.com
GMAIL_APP_PASSWORD=replace-with-16-char-app-password

# Where contact form submissions get emailed to (defaults to GMAIL_USER if unset)
CONTACT_TO=emailsuryateja.m@gmail.com
CONTACT_FROM_NAME=suryateja.pro contact form
