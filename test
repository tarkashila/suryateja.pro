                    </div>
                     <div class="text-center p-4 glass-card rounded-lg w-32 h-32 flex flex-col justify-center items-center">
                        <i data-lucide="wind" class="w-12 h-12 mb-2 text-cyan-400"></i>
                        <span>Tailwind</span>
                    </div>
                    <div class="text-center p-4 glass-card rounded-lg w-32 h-32 flex flex-col justify-center items-center">
                        <i data-lucide="figma" class="w-12 h-12 mb-2 text-pink-400"></i>
