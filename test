        <!-- Skills Section -->
        <section id="skills" class="py-20 scroll-reveal">
            <h2 class="text-4xl font-bold text-center mb-12">My Tech Stack</h2>
            <div class="max-w-4xl mx-auto text-center">
                <div class="flex flex-wrap justify-center items-center gap-6">
                    <!-- Example Skill -->
                    <div class="text-center p-4 glass-card rounded-lg w-32 h-32 flex flex-col justify-center items-center">
