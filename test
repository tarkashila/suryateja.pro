        </section>

        <!-- Contact Section -->
        <section id="contact" class="py-20 text-center scroll-reveal">
             <h2 class="text-4xl font-bold text-center mb-4">Get In Touch</h2>
             <p class="max-w-xl mx-auto text-neutral-400 mb-8">
                 I'm currently open to new opportunities and collaborations. Feel free to reach out, and I'll get back to you as soon as possible!
             </p>
             <a href="mailto:hello@alexdoe.com" class="inline-block px-8 py-4 bg-sky-500 hover:bg-sky-600 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105">
